{
  "Properties": {
    "AssumeRolePolicyDocument": {
      "Statement": [
        {
          "Action": "sts:AssumeRole",
          "Effect": "Allow",
          "Principal": {
            "Service": "scheduler.amazonaws.com"
          }
        }
      ],
      "Version": "2012-10-17"
    },
    "Policies": [
      {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "states:StartExecution",
              "Effect": "Allow",
              "Resource": {
                "Ref": "PipelineStateMachine"
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "PolicyName": "InvokePipelineStateMachine"
      }
    ],
    "RoleName": "acme-dev-polyris-orders-scheduler-role",
    "Tags": [
      {
        "Key": "polyris:namespace",
        "Value": "acme"
      },
      {
        "Key": "polyris:stage",
        "Value": "dev"
      },
      {
        "Key": "polyris:component",
        "Value": "pipeline"
      },
      {
        "Key": "polyris:pipeline",
        "Value": "orders"
      }
    ]
  },
  "Type": "AWS::IAM::Role"
}
