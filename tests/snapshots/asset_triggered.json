{
  "QueryLanguage": "JSONata",
  "StartAt": "Register_Pipeline",
  "States": {
    "Register_Pipeline": {
      "Type": "Task",
      "Comment": "Register pipeline metadata for UI and asset triggers",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Arguments": {
        "TableName": "${registry_table}",
        "Item": {
          "pipeline_name": {
            "S": "asset_triggered"
          },
          "sfn_arn": {
            "S": "{% $states.context.StateMachine.Id %}"
          },
          "description": {
            "S": ""
          },
          "pipeline_group": {
            "S": ""
          },
          "tasks": {
            "S": "[{\"task_id\": \"process\", \"task_type\": \"sfn\", \"dependencies\": []}]"
          },
          "dag": {
            "S": "{\"nodes\": [{\"id\": \"process\", \"name\": \"process\", \"type\": \"task\", \"task_type\": \"sfn\"}], \"edges\": []}"
          },
          "schedule": {
            "S": ""
          },
          "asset_schedule": {
            "S": "{\"operator\": \"AND\", \"assets\": [\"raw/inventory\", \"raw/catalog\"]}"
          },
          "registered_at": {
            "S": "{% $now() %}"
          },
          "last_execution": {
            "S": "{% $states.context.Execution.Name %}"
          }
        }
      },
      "Output": "{% $states.input %}",
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.ThrottlingException",
            "DynamoDB.InternalServerError",
            "States.Timeout"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $merge([$states.input, {'_registration_error': $states.errorOutput.Cause}]) %}",
          "Next": "Warn_Registration_Failed"
        }
      ],
      "Next": "Save_DAG_Snapshot"
    },
    "Warn_Registration_Failed": {
      "Type": "Task",
      "Comment": "Write register failure to UI notifications",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Arguments": {
        "TableName": "${tokens_table}",
        "Item": {
          "execution_name": {
            "S": "{% '_notify_warn_' & $states.context.Execution.Name & '-register_pipeline' %}"
          },
          "pipeline_name": {
            "S": "asset_triggered"
          },
          "pipeline_execution": {
            "S": "{% $states.context.Execution.Name %}"
          },
          "task_name": {
            "S": "Register_Pipeline"
          },
          "date": {
            "S": "{% $exists($states.input.variables.current_date) ? $states.input.variables.current_date : ($exists($states.input.current_date) ? $states.input.current_date : $substringBefore($now(), 'T')) %}"
          },
          "status": {
            "S": "failed"
          },
          "error": {
            "S": "{% 'Register_Pipeline failed: ' & $string($states.input._registration_error) %}"
          },
          "finished_at": {
            "S": "{% $now() %}"
          },
          "ttl": {
            "N": "{% $string($floor($toMillis($now()) / 1000) + 86400) %}"
          }
        }
      },
      "Output": "{% $sift($states.input, function($v, $k) { $k != '_registration_error' }) %}",
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.ThrottlingException",
            "DynamoDB.InternalServerError",
            "States.Timeout"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $sift($states.input, function($v, $k) { $k != '_registration_error' }) %}",
          "Next": "Save_DAG_Snapshot"
        }
      ],
      "Next": "Save_DAG_Snapshot"
    },
    "Save_DAG_Snapshot": {
      "Type": "Task",
      "Comment": "Snapshot DAG structure for this execution (survives redeploys)",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Arguments": {
        "TableName": "${tokens_table}",
        "Item": {
          "execution_name": {
            "S": "{% 'dag_snapshot::' & $states.context.Execution.Name %}"
          },
          "pipeline_name": {
            "S": "asset_triggered"
          },
          "pipeline_execution": {
            "S": "{% $states.context.Execution.Name %}"
          },
          "dag": {
            "S": "{\"nodes\": [{\"id\": \"process\", \"name\": \"process\", \"type\": \"task\", \"task_type\": \"sfn\"}], \"edges\": []}"
          },
          "snapshot_at": {
            "S": "{% $now() %}"
          },
          "ttl": {
            "N": "{% $string($floor($toMillis($now()) / 1000) + 10368000) %}"
          }
        }
      },
      "Output": "{% $states.input %}",
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.ThrottlingException",
            "DynamoDB.InternalServerError",
            "States.Timeout"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $merge([$states.input, {'_snapshot_error': $states.errorOutput.Cause}]) %}",
          "Next": "Warn_Snapshot_Failed"
        }
      ],
      "Next": "Register_Asset_Subscriptions"
    },
    "Warn_Snapshot_Failed": {
      "Type": "Task",
      "Comment": "Write snapshot failure to UI notifications",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Arguments": {
        "TableName": "${tokens_table}",
        "Item": {
          "execution_name": {
            "S": "{% '_notify_warn_' & $states.context.Execution.Name & '-save_dag_snapshot' %}"
          },
          "pipeline_name": {
            "S": "asset_triggered"
          },
          "pipeline_execution": {
            "S": "{% $states.context.Execution.Name %}"
          },
          "task_name": {
            "S": "Save_DAG_Snapshot"
          },
          "date": {
            "S": "{% $exists($states.input.variables.current_date) ? $states.input.variables.current_date : ($exists($states.input.current_date) ? $states.input.current_date : $substringBefore($now(), 'T')) %}"
          },
          "status": {
            "S": "failed"
          },
          "error": {
            "S": "{% 'Save_DAG_Snapshot failed: ' & $string($states.input._snapshot_error) %}"
          },
          "finished_at": {
            "S": "{% $now() %}"
          },
          "ttl": {
            "N": "{% $string($floor($toMillis($now()) / 1000) + 86400) %}"
          }
        }
      },
      "Output": "{% $sift($states.input, function($v, $k) { $k != '_snapshot_error' }) %}",
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.ThrottlingException",
            "DynamoDB.InternalServerError",
            "States.Timeout"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $sift($states.input, function($v, $k) { $k != '_snapshot_error' }) %}",
          "Next": "Register_Asset_Subscriptions"
        }
      ],
      "Next": "Register_Asset_Subscriptions"
    },
    "Register_Asset_Subscriptions": {
      "Type": "Map",
      "Comment": "Register subscription for each asset (enables Query instead of Scan)",
      "Items": [
        "raw/inventory",
        "raw/catalog"
      ],
      "MaxConcurrency": 10,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "WriteSubscription",
        "States": {
          "WriteSubscription": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Arguments": {
              "TableName": "${asset_subscriptions_table}",
              "Item": {
                "asset_name": {
                  "S": "{% $states.input %}"
                },
                "pipeline_name": {
                  "S": "asset_triggered"
                },
                "sfn_arn": {
                  "S": "{% $states.context.StateMachine.Id %}"
                },
                "operator": {
                  "S": "AND"
                },
                "assets": {
                  "S": "[\"raw/inventory\", \"raw/catalog\"]"
                },
                "registered_at": {
                  "S": "{% $now() %}"
                }
              }
            },
            "Output": "{% null %}",
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.ThrottlingException",
                  "DynamoDB.InternalServerError",
                  "States.Timeout"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Output": "{% {'_asset_name': $states.input, '_subscription_error': $states.errorOutput.Cause} %}",
                "Next": "Warn_WriteSubscription_Failed"
              }
            ],
            "End": true
          },
          "Warn_WriteSubscription_Failed": {
            "Type": "Task",
            "Comment": "Write subscription failure to UI notifications",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Arguments": {
              "TableName": "${tokens_table}",
              "Item": {
                "execution_name": {
                  "S": "{% '_notify_warn_' & $states.context.Execution.Name & '-write_subscription-' & $string($states.input._asset_name) %}"
                },
                "pipeline_name": {
                  "S": "asset_triggered"
                },
                "pipeline_execution": {
                  "S": "{% $states.context.Execution.Name %}"
                },
                "task_name": {
                  "S": "WriteSubscription"
                },
                "date": {
                  "S": "{% $exists($states.input.variables.current_date) ? $states.input.variables.current_date : ($exists($states.input.current_date) ? $states.input.current_date : $substringBefore($now(), 'T')) %}"
                },
                "status": {
                  "S": "failed"
                },
                "error": {
                  "S": "{% 'WriteSubscription failed for ' & $string($states.input._asset_name) & ': ' & $string($states.input._subscription_error) %}"
                },
                "finished_at": {
                  "S": "{% $now() %}"
                },
                "ttl": {
                  "N": "{% $string($floor($toMillis($now()) / 1000) + 86400) %}"
                }
              }
            },
            "Output": "{% null %}",
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.ThrottlingException",
                  "DynamoDB.InternalServerError",
                  "States.Timeout"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Output": "{% null %}",
                "Next": "Subscription_Skipped"
              }
            ],
            "End": true
          },
          "Subscription_Skipped": {
            "Type": "Succeed"
          }
        }
      },
      "Output": "{% $states.input %}",
      "Next": "Check_Register_Only"
    },
    "Check_Register_Only": {
      "Type": "Choice",
      "Comment": "Skip task execution if register_only=true (used by polyris-register CLI)",
      "Choices": [
        {
          "Condition": "{% $states.input.register_only = true %}",
          "Next": "Registration_Complete"
        }
      ],
      "Default": "Run_All_Tasks"
    },
    "Registration_Complete": {
      "Type": "Succeed",
      "Comment": "Registration completed without running tasks"
    },
    "Run_All_Tasks": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "Task_process",
          "States": {
            "Task_process": {
              "Type": "Task",
              "Resource": "arn:aws:states:::states:startExecution.waitForTaskToken",
              "TimeoutSeconds": 86400,
              "Arguments": {
                "StateMachineArn": "${wrapper_arn}",
                "Name": "{% $substring('process-' & ($exists($states.input.variables.current_date) ? $states.input.variables.current_date : ($exists($states.input.current_date) ? $states.input.current_date : $substringBefore($now(), 'T'))) & '-' & ($length($states.context.Execution.Name) > 8 ? $substring($states.context.Execution.Name, $length($states.context.Execution.Name) - 8) : $states.context.Execution.Name), 0, 80) %}",
                "Input": {
                  "task_name": "process",
                  "task_arn": "arn:aws:states:us-east-1:123:stateMachine:process",
                  "task_type": "sfn",
                  "dependencies": [],
                  "cross_account_role": "same",
                  "token": "{% $states.context.Task.Token %}",
                  "pipeline_name": "asset_triggered",
                  "pipeline_execution": "{% $states.context.Execution.Name %}",
                  "skip_tasks": "{% $exists($states.input.skip_tasks) ? $states.input.skip_tasks : [] %}",
                  "_suppress_asset_event": "{% $exists($states.input._suppress_asset_event) ? $states.input._suppress_asset_event : false %}",
                  "cascade_all": "{% $exists($states.input.cascade_all) ? $states.input.cascade_all : false %}",
                  "triggered_by": "{% $exists($states.input.triggered_by) ? $states.input.triggered_by : 'unknown' %}",
                  "date": "{% $exists($states.input.variables.current_date) ? $states.input.variables.current_date : ($exists($states.input.current_date) ? $states.input.current_date : $substringBefore($now(), 'T')) %}",
                  "current_date": "{% $exists($states.input.variables.current_date) ? $states.input.variables.current_date : ($exists($states.input.current_date) ? $states.input.current_date : $substringBefore($now(), 'T')) %}",
                  "PARTITION_ARG": "{% $exists($states.input.variables.PARTITION_ARG) ? $states.input.variables.PARTITION_ARG : ($exists($states.input.PARTITION_ARG) ? $states.input.PARTITION_ARG : ($exists($states.input.variables.current_date) ? $states.input.variables.current_date : ($exists($states.input.current_date) ? $states.input.current_date : $substringBefore($now(), 'T')))) %}",
                  "variables": "{% $exists($states.input.variables) ? $states.input.variables : {} %}",
                  "orchestration_timeout": 86400,
                  "wait_before": 0,
                  "trigger_rule": "all_success",
                  "pipeline_execution_short": "{% ( $exec := $states.context.Execution.Name; $short := $length($exec) > 20 ? $substring($exec, $length($exec) - 20) : $exec; $replace($replace($short, '.', ''), ':', '') ) %}"
                }
              },
              "End": true
            }
          }
        }
      ],
      "End": true,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Pipeline_Failed"
        }
      ]
    },
    "Pipeline_Failed": {
      "Type": "Fail",
      "Error": "PipelineFailed",
      "Cause": "Infrastructure error - wrapper did not handle"
    }
  }
}
