{
  "QueryLanguage": "JSONata",
  "StartAt": "Register_Pipeline",
  "States": {
    "Register_Pipeline": {
      "Type": "Task",
      "Comment": "Refresh pipeline metadata for UI and asset triggers (registered_at is owned by polyris-deploy, not written here)",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${registry_table}",
        "Key": {
          "pipeline_name": {
            "S": "consecutive_wait_for"
          }
        },
        "UpdateExpression": "SET sfn_arn = :sfn_arn, #description = :description, pipeline_group = :pipeline_group, #schedule = :schedule, asset_schedule = :asset_schedule, last_execution = :last_execution, spec_id = :spec_id, task_count = :task_count REMOVE #tasks, #dag",
        "ExpressionAttributeNames": {
          "#description": "description",
          "#tasks": "tasks",
          "#dag": "dag",
          "#schedule": "schedule"
        },
        "ExpressionAttributeValues": {
          ":sfn_arn": {
            "S": "{% $states.context.StateMachine.Id %}"
          },
          ":description": {
            "S": ""
          },
          ":pipeline_group": {
            "S": ""
          },
          ":schedule": {
            "S": "cron(0 22 ? * SUN *)"
          },
          ":asset_schedule": {
            "S": "{}"
          },
          ":last_execution": {
            "S": "{% $states.context.Execution.Name %}"
          },
          ":spec_id": {
            "S": "consecutive_wait_for#fae2161ac2fb82826d0b4e09fcef2b11ecce0973214879b71fb74818e1a949c5"
          },
          ":task_count": {
            "N": "1"
          }
        }
      },
      "Output": "{% $states.input %}",
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.ThrottlingException",
            "DynamoDB.InternalServerError",
            "States.Timeout"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.DataLimitExceeded"
          ],
          "Output": "{% $merge([$states.input, {'_registration_error': $states.errorOutput.Cause}]) %}",
          "Next": "Warn_Registration_Failed"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $merge([$states.input, {'_registration_error': $states.errorOutput.Cause}]) %}",
          "Next": "Warn_Registration_Failed"
        }
      ],
      "Next": "Check_Register_Only"
    },
    "Warn_Registration_Failed": {
      "Type": "Task",
      "Comment": "Write register failure to UI notifications",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Arguments": {
        "TableName": "${tokens_table}",
        "Item": {
          "execution_name": {
            "S": "{% '_notify_warn_coordination_' & $states.context.Execution.Name & '-register_pipeline' %}"
          },
          "kind": {
            "S": "coordination"
          },
          "task_name": {
            "S": "Register_Pipeline"
          },
          "pipeline_name": {
            "S": "consecutive_wait_for"
          },
          "pipeline_execution": {
            "S": "{% $states.context.Execution.Name %}"
          },
          "task_date": {
            "S": "{% ($states.input.variables.current_date ? $states.input.variables.current_date : ($states.input.current_date ? $states.input.current_date : ($states.input.scheduled_time ? $substringBefore($states.input.scheduled_time, 'T') : $substringBefore($states.context.Execution.StartTime, 'T')))) %}"
          },
          "status": {
            "S": "failed"
          },
          "error": {
            "S": "{% 'Register_Pipeline failed: ' & $string($states.input._registration_error) %}"
          },
          "finished_at": {
            "S": "{% $now() %}"
          },
          "attention": {
            "S": "{% 'warn#' & $substring($hash($states.context.Execution.Name & '-register_pipeline', 'SHA-256'), 0, 1) %}"
          },
          "attention_at": {
            "S": "{% $now() %}"
          },
          "ttl": {
            "N": "{% $string($floor($toMillis($now()) / 1000) + 8 * 86400) %}"
          }
        }
      },
      "Output": "{% $sift($states.input, function($v, $k) { $k != '_registration_error' }) %}",
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.ThrottlingException",
            "DynamoDB.InternalServerError",
            "States.Timeout"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $sift($states.input, function($v, $k) { $k != '_registration_error' }) %}",
          "Next": "Check_Register_Only"
        }
      ],
      "Next": "Check_Register_Only"
    },
    "Check_Register_Only": {
      "Type": "Choice",
      "Comment": "Skip task execution if register_only=true (used by polyris-register CLI)",
      "Choices": [
        {
          "Condition": "{% $states.input.register_only = true %}",
          "Next": "Registration_Complete"
        }
      ],
      "Default": "Run_All_Tasks"
    },
    "Registration_Complete": {
      "Type": "Succeed",
      "Comment": "Registration completed without running tasks"
    },
    "Run_All_Tasks": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "Start_Run",
          "States": {
            "Start_Run": {
              "Type": "Task",
              "Comment": "Write the run's rows; the dispatcher answers this token once every row is final",
              "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
              "Arguments": {
                "FunctionName": "${start_run_function_arn}",
                "Payload": {
                  "format_version": 1,
                  "spec_id": "consecutive_wait_for#fae2161ac2fb82826d0b4e09fcef2b11ecce0973214879b71fb74818e1a949c5",
                  "task_count": 1,
                  "pipeline_name": "consecutive_wait_for",
                  "execution_name": "{% $states.context.Execution.Name %}",
                  "execution_arn": "{% $states.context.Execution.Id %}",
                  "execution_start": "{% $states.context.Execution.StartTime %}",
                  "token": "{% $states.context.Task.Token %}",
                  "retry_count": "{% $states.context.State.RetryCount %}",
                  "redrive_count": "{% $exists($states.context.Execution.RedriveCount) ? $states.context.Execution.RedriveCount : 0 %}",
                  "date": "{% ($states.input.variables.current_date ? $states.input.variables.current_date : ($states.input.current_date ? $states.input.current_date : ($states.input.scheduled_time ? $substringBefore($states.input.scheduled_time, 'T') : $substringBefore($states.context.Execution.StartTime, 'T')))) %}",
                  "input": {
                    "variables": "{% $exists($states.input.variables) ? $states.input.variables : {} %}",
                    "skip_tasks": "{% $exists($states.input.skip_tasks) ? $states.input.skip_tasks : [] %}",
                    "cascade_all": "{% $exists($states.input.cascade_all) ? $states.input.cascade_all : false %}",
                    "_suppress_asset_event": "{% $exists($states.input._suppress_asset_event) ? $states.input._suppress_asset_event : false %}",
                    "triggered_by": "{% $exists($states.input.triggered_by) ? $states.input.triggered_by : 'unknown' %}",
                    "PARTITION_ARG": "{% $states.input.variables.PARTITION_ARG ? $states.input.variables.PARTITION_ARG : ($states.input.PARTITION_ARG ? $states.input.PARTITION_ARG : ($states.input.variables.current_date ? $states.input.variables.current_date : ($states.input.current_date ? $states.input.current_date : ($states.input.scheduled_time ? $substringBefore($states.input.scheduled_time, 'T') : $substringBefore($states.context.Execution.StartTime, 'T'))))) %}",
                    "backfill_id": "{% $exists($states.context.Execution.Input.backfill_id) ? $states.context.Execution.Input.backfill_id : null %}"
                  }
                }
              },
              "Output": {},
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException",
                    "Lambda.Unknown",
                    "Sandbox.Timedout",
                    "CoordinationTransient"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 6,
                  "BackoffRate": 2,
                  "MaxDelaySeconds": 60,
                  "JitterStrategy": "FULL"
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "Polyris.RunFailed"
                  ],
                  "Output": {
                    "_polyris_branch_error": {
                      "branch": "Start_Run",
                      "error": "{% $states.errorOutput.Error %}",
                      "cause": "{% $exists($states.errorOutput.Cause) ? $states.errorOutput.Cause : '' %}",
                      "date": "{% ($states.input.variables.current_date ? $states.input.variables.current_date : ($states.input.current_date ? $states.input.current_date : ($states.input.scheduled_time ? $substringBefore($states.input.scheduled_time, 'T') : $substringBefore($states.context.Execution.StartTime, 'T')))) %}"
                    }
                  },
                  "Next": "Run_Ended_Failed"
                },
                {
                  "ErrorEquals": [
                    "States.DataLimitExceeded"
                  ],
                  "Output": {
                    "_polyris_branch_error": {
                      "branch": "Start_Run",
                      "error": "{% $states.errorOutput.Error %}",
                      "cause": "{% $exists($states.errorOutput.Cause) ? $states.errorOutput.Cause : '' %}",
                      "date": "{% ($states.input.variables.current_date ? $states.input.variables.current_date : ($states.input.current_date ? $states.input.current_date : ($states.input.scheduled_time ? $substringBefore($states.input.scheduled_time, 'T') : $substringBefore($states.context.Execution.StartTime, 'T')))) %}"
                    }
                  },
                  "Next": "Warn_Start_Run_Failed"
                },
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "Output": {
                    "_polyris_branch_error": {
                      "branch": "Start_Run",
                      "error": "{% $states.errorOutput.Error %}",
                      "cause": "{% $exists($states.errorOutput.Cause) ? $states.errorOutput.Cause : '' %}",
                      "date": "{% ($states.input.variables.current_date ? $states.input.variables.current_date : ($states.input.current_date ? $states.input.current_date : ($states.input.scheduled_time ? $substringBefore($states.input.scheduled_time, 'T') : $substringBefore($states.context.Execution.StartTime, 'T')))) %}"
                    }
                  },
                  "Next": "Warn_Start_Run_Failed"
                }
              ],
              "End": true
            },
            "Warn_Start_Run_Failed": {
              "Type": "Task",
              "Comment": "No task of the run started: show why in the console bell",
              "Resource": "arn:aws:states:::dynamodb:putItem",
              "Arguments": {
                "TableName": "${tokens_table}",
                "Item": {
                  "execution_name": {
                    "S": "{% '_notify_warn_coordination_' & $states.context.Execution.Name & '-start_run' %}"
                  },
                  "kind": {
                    "S": "coordination"
                  },
                  "task_name": {
                    "S": "Start_Run"
                  },
                  "pipeline_name": {
                    "S": "consecutive_wait_for"
                  },
                  "pipeline_execution": {
                    "S": "{% $states.context.Execution.Name %}"
                  },
                  "task_date": {
                    "S": "{% $states.input._polyris_branch_error.date %}"
                  },
                  "status": {
                    "S": "failed"
                  },
                  "error": {
                    "S": "{% 'Start_Run failed, so no task of the run started: ' & $states.input._polyris_branch_error.error & ': ' & $states.input._polyris_branch_error.cause %}"
                  },
                  "finished_at": {
                    "S": "{% $now() %}"
                  },
                  "attention": {
                    "S": "{% 'warn#' & $substring($hash($states.context.Execution.Name & '-start_run', 'SHA-256'), 0, 1) %}"
                  },
                  "attention_at": {
                    "S": "{% $now() %}"
                  },
                  "ttl": {
                    "N": "{% $string($floor($toMillis($now()) / 1000) + 8 * 86400) %}"
                  }
                }
              },
              "Output": "{% $states.input %}",
              "Retry": [
                {
                  "ErrorEquals": [
                    "DynamoDB.ProvisionedThroughputExceededException",
                    "DynamoDB.ThrottlingException",
                    "DynamoDB.InternalServerError",
                    "States.Timeout"
                  ],
                  "IntervalSeconds": 1,
                  "MaxAttempts": 3,
                  "BackoffRate": 2,
                  "JitterStrategy": "FULL"
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "Output": "{% $states.input %}",
                  "Next": "Run_Ended_Failed"
                }
              ],
              "Next": "Run_Ended_Failed"
            },
            "Run_Ended_Failed": {
              "Type": "Pass",
              "Comment": "The error is recorded; the pipeline fails after the Parallel",
              "End": true
            }
          }
        }
      ],
      "Next": "Check_Branches",
      "Catch": [
        {
          "ErrorEquals": [
            "States.DataLimitExceeded"
          ],
          "Next": "Pipeline_Failed"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Pipeline_Failed"
        }
      ]
    },
    "Check_Branches": {
      "Type": "Choice",
      "Comment": "Fail the execution once every branch has ended, if one of them recorded an error",
      "Choices": [
        {
          "Condition": "{% $count($states.input[$exists(_polyris_branch_error)]._polyris_branch_error) > 0 %}",
          "Next": "Run_Failed"
        }
      ],
      "Default": "Run_Succeeded"
    },
    "Run_Failed": {
      "Type": "Fail",
      "Error": "{% ($errors := $states.input[$exists(_polyris_branch_error)]._polyris_branch_error; $errors[0].error) %}",
      "Cause": "{% ($errors := $states.input[$exists(_polyris_branch_error)]._polyris_branch_error; $substring($join($append([], $errors.(branch & ': ' & error & (cause = '' ? '' : ': ' & cause))), '; '), 0, 32768)) %}"
    },
    "Run_Succeeded": {
      "Type": "Succeed"
    },
    "Pipeline_Failed": {
      "Type": "Fail",
      "Comment": "The Parallel itself failed: a branch failed outside its own Catch",
      "Error": "{% $exists($states.input.Error) ? $states.input.Error : 'PipelineFailed' %}",
      "Cause": "{% $exists($states.input.Cause) ? $states.input.Cause : '' %}"
    }
  }
}
