{
  "Comment": "Notify dependents (ADR #130 §6.2): ask the reconciler to re-check every task that subscribed to the completed one. These are hints: a lost one delays a task until the sweeper's next check, so nothing here fails the caller.",
  "QueryLanguage": "JSONata",
  "StartAt": "Query_Subscriptions",
  "States": {
    "Query_Subscriptions": {
      "Type": "Task",
      "Comment": "Consistent, paginated read of {completed task}-{pipeline_execution_short} subscriptions. Each subscriber is a waiting task's execution_name (ADR #130 §5).",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${query_subscriptions_lambda}",
        "Payload": {
          "task_name": "{% $states.input.task_name %}",
          "pipeline_execution_short": "{% $states.input.pipeline_execution_short %}"
        }
      },
      "Output": "{% { 'subscribers': $exists($states.result.Payload.subscribers) ? $states.result.Payload.subscribers : [] } %}",
      "Next": "Has_Subscribers",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Comment": "Hints lost; the sweeper re-checks the waiting tasks.",
          "Output": "{% { 'lost': $states.errorOutput } %}",
          "Next": "Done"
        }
      ]
    },
    "Has_Subscribers": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $count($states.input.subscribers) > 0 %}",
          "Next": "Reconcile_Subscribers"
        }
      ],
      "Default": "Done"
    },
    "Reconcile_Subscribers": {
      "Type": "Map",
      "Comment": "One reconcile call per subscriber. A failure for one never stops the others, and the Map never fails.",
      "Items": "{% $append([], $map($states.input.subscribers, function($s) { {'execution_name': $s.subscriber} })) %}",
      "MaxConcurrency": 10,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "Reconcile",
        "States": {
          "Reconcile": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Arguments": {
              "FunctionName": "${reconcile_function_arn}",
              "Payload": {
                "execution_name": "{% $states.input.execution_name %}",
                "source": "notify_dependents"
              }
            },
            "Output": "{% { 'execution_name': $states.input.execution_name, 'verdict': $states.result.Payload.verdict, 'action': $states.result.Payload.action } %}",
            "End": true,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException",
                  "CoordinationTransient"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 4,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Comment": "Hint lost; the sweeper re-checks this task.",
                "Output": "{% { 'execution_name': $states.input.execution_name, 'lost': $states.errorOutput } %}",
                "Next": "Hint_Lost"
              }
            ]
          },
          "Hint_Lost": {
            "Type": "Pass",
            "End": true
          }
        }
      },
      "Next": "Done"
    },
    "Done": {
      "Type": "Succeed"
    }
  }
}
