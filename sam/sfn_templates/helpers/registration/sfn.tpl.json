{
  "Comment": "Registration helper (ADR #130 §6.3). Save the task row; signal a root task at once; otherwise write the run's subscriptions and ask the reconciler. Every failure is caught, so a task never hangs silently (B-G1): a lost row or a non-transient failure fails the task with its cause, a transient one leaves the saved row due for the sweeper.",
  "QueryLanguage": "JSONata",
  "StartAt": "Save_Task_Record",
  "States": {
    "Save_Task_Record": {
      "Type": "Task",
      "Comment": "Register the task row. attention/attention_at put it in the attention index (ADR #130 §7): due for a sweeper check 10 minutes from now. starter_input is the wrapper's own start input, which a restart replays.",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Arguments": {
        "TableName": "${tokens_table}",
        "Item": {
          "execution_name": {
            "S": "{% $states.input.execution_name %}"
          },
          "task_name": {
            "S": "{% $states.input.task_name %}"
          },
          "task_arn": {
            "S": "{% $states.input.task_arn %}"
          },
          "status": {
            "S": "waiting"
          },
          "dependencies": {
            "S": "{% $string($states.input.dependencies) %}"
          },
          "orchestration_token": {
            "S": "{% $states.input.orchestration_token %}"
          },
          "wait_token": {
            "S": "{% $states.input.wait_token %}"
          },
          "cross_account_role": {
            "S": "{% $states.input.cross_account_role %}"
          },
          "wait_before": {
            "N": "{% $string($exists($states.input.wait_before) ? $states.input.wait_before : 0) %}"
          },
          "trigger_rule": {
            "S": "{% $exists($states.input.trigger_rule) ? $states.input.trigger_rule : 'all_success' %}"
          },
          "date": {
            "S": "{% $states.input.date %}"
          },
          "started_at": {
            "S": "{% $now() %}"
          },
          "ttl": {
            "N": "{% $string($states.input.ttl) %}"
          },
          "pipeline_name": {
            "S": "{% $exists($states.input.pipeline_name) ? $states.input.pipeline_name : 'unknown' %}"
          },
          "pipeline_execution": {
            "S": "{% $exists($states.input.pipeline_execution) ? $states.input.pipeline_execution : 'unknown' %}"
          },
          "pipeline_execution_short": {
            "S": "{% $exists($states.input.pipeline_execution_short) ? $states.input.pipeline_execution_short : 'unknown' %}"
          },
          "wrapper_execution_arn": {
            "S": "{% $exists($states.input.wrapper_execution_arn) ? $states.input.wrapper_execution_arn : '' %}"
          },
          "task_type": {
            "S": "{% $exists($states.input.task_type) ? $states.input.task_type : 'sfn' %}"
          },
          "task_config": {
            "S": "{% $exists($states.input.task_config) ? $string($states.input.task_config) : '{}' %}"
          },
          "outlets": {
            "S": "{% $exists($states.input.outlets) ? $string($states.input.outlets) : '[]' %}"
          },
          "wait_for": {
            "S": "{% $exists($states.input.wait_for) ? $string($states.input.wait_for) : '[]' %}"
          },
          "triggered_by": {
            "S": "{% $exists($states.input.triggered_by) ? $states.input.triggered_by : 'unknown' %}"
          },
          "starter_input": {
            "S": "{% $string($states.input.starter_input) %}"
          },
          "orchestration_timeout": {
            "N": "{% $string($states.input.orchestration_timeout) %}"
          },
          "attention": {
            "S": "{% 'waiting#' & $substring($hash($states.input.execution_name, 'SHA-256'), 0, 1) %}"
          },
          "attention_at": {
            "S": "{% $fromMillis($toMillis($now()) + 600000) %}"
          }
        }
      },
      "Output": "{% $states.input %}",
      "Next": "Is_Root_Task",
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.ThrottlingException",
            "DynamoDB.InternalServerError",
            "States.Timeout"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Comment": "No row exists for the sweeper to find: the task must fail now, with the cause.",
          "Output": "{% $states.input ~> |$| {'failure': $states.errorOutput} | %}",
          "Next": "Fail_Task"
        }
      ]
    },
    "Is_Root_Task": {
      "Type": "Choice",
      "Comment": "Fast path: no dependencies and no wait_for. A paused run holds the task at run start (pause_waiter).",
      "Choices": [
        {
          "Condition": "{% $count($states.input.dependencies) = 0 and $count($exists($states.input.wait_for) ? $states.input.wait_for : []) = 0 %}",
          "Next": "Signal_Root_Task"
        }
      ],
      "Default": "Save_Subscriptions"
    },
    "Signal_Root_Task": {
      "Type": "Task",
      "Comment": "The wrapper writes deps_ready itself when it receives this (ADR #130 §6.4).",
      "Resource": "arn:aws:states:::aws-sdk:sfn:sendTaskSuccess",
      "Arguments": {
        "TaskToken": "{% $states.input.wait_token %}",
        "Output": "{\"signal\":\"deps_ready\",\"reason\":\"no dependencies\"}"
      },
      "Output": "{% $states.input %}",
      "Next": "Registered",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Comment": "The row is saved and indexed; the sweeper reconciles it.",
          "Output": "{% $states.input %}",
          "Next": "Defer_To_Sweeper"
        }
      ]
    },
    "Save_Subscriptions": {
      "Type": "Map",
      "Comment": "Per-run pointers (ADR #130 §5): one per task dependency ({upstream}-{pipeline_execution_short}) and one per wait_for asset (asset:{name}), all with subscriber = execution_name. No token on them: the token lives on the task row.",
      "Items": "{% ( $short := $states.input.pipeline_execution_short; $me := $states.input.execution_name; $ttl := $states.input.ttl; $names := $distinct($exists($states.input.wait_for) ? $states.input.wait_for.**.asset_name : []); $deps := $map($states.input.dependencies, function($d) { {'dependency_key': $d & '-' & $short, 'subscriber': $me, 'ttl': $ttl} }); $assets := $map($names, function($a) { {'dependency_key': 'asset:' & $a, 'subscriber': $me, 'ttl': $ttl} }); $append($append([], $deps), $assets) ) %}",
      "MaxConcurrency": 10,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "Save_Subscription",
        "States": {
          "Save_Subscription": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Arguments": {
              "TableName": "${subscriptions_table}",
              "Item": {
                "dependency_key": {
                  "S": "{% $states.input.dependency_key %}"
                },
                "subscriber": {
                  "S": "{% $states.input.subscriber %}"
                },
                "ttl": {
                  "N": "{% $string($states.input.ttl) %}"
                }
              }
            },
            "Output": "{% $states.input.dependency_key %}",
            "End": true,
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.ThrottlingException",
                  "DynamoDB.InternalServerError",
                  "States.Timeout"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ]
          }
        }
      },
      "Output": "{% $states.input %}",
      "Next": "Reconcile",
      "Catch": [
        {
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.ThrottlingException",
            "DynamoDB.InternalServerError",
            "States.Timeout"
          ],
          "Comment": "Transient after retries: the row is saved; the sweeper reconciles it from facts.",
          "Output": "{% $states.input %}",
          "Next": "Defer_To_Sweeper"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $states.input ~> |$| {'failure': $states.errorOutput} | %}",
          "Next": "Fail_Task"
        }
      ]
    },
    "Reconcile": {
      "Type": "Task",
      "Comment": "The reconciler decides from facts and signals the wrapper itself (ADR #130 §3). It raises only CoordinationTransient; it handles every other failure.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${reconcile_function_arn}",
        "Payload": {
          "execution_name": "{% $states.input.execution_name %}",
          "source": "registration"
        }
      },
      "Output": "{% $states.input %}",
      "Next": "Registered",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "CoordinationTransient"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "CoordinationTransient"
          ],
          "Comment": "Transient after retries: the row is saved; the sweeper reconciles it from facts.",
          "Output": "{% $states.input %}",
          "Next": "Defer_To_Sweeper"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $states.input ~> |$| {'failure': $states.errorOutput} | %}",
          "Next": "Fail_Task"
        }
      ]
    },
    "Defer_To_Sweeper": {
      "Type": "Task",
      "Comment": "Make the saved row due now, so the next sweeper run reconciles it. If even this fails, the row is still due within 10 minutes.",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${tokens_table}",
        "Key": {
          "execution_name": {
            "S": "{% $states.input.execution_name %}"
          }
        },
        "UpdateExpression": "SET attention_at = :now",
        "ConditionExpression": "wait_token = :token AND #s IN (:waiting, :paused)",
        "ExpressionAttributeNames": {
          "#s": "status"
        },
        "ExpressionAttributeValues": {
          ":now": {
            "S": "{% $now() %}"
          },
          ":token": {
            "S": "{% $states.input.wait_token %}"
          },
          ":waiting": {
            "S": "waiting"
          },
          ":paused": {
            "S": "waiting_paused"
          }
        }
      },
      "Output": "{% $states.input %}",
      "Next": "Registered",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $states.input %}",
          "Next": "Registered"
        }
      ]
    },
    "Fail_Task": {
      "Type": "Task",
      "Comment": "Fail the wrapper's wait with the real cause. The error name is never States.*, so the wrapper's Retry cannot turn it into a re-registration; its Catch runs the failure handler.",
      "Resource": "arn:aws:states:::aws-sdk:sfn:sendTaskFailure",
      "Arguments": {
        "TaskToken": "{% $states.input.wait_token %}",
        "Error": "CoordinationError",
        "Cause": "{% $substring('registration failed: ' & $states.input.failure.Error & ': ' & $string($states.input.failure.Cause), 0, 32000) %}"
      },
      "Output": "{% $states.input %}",
      "Next": "Registered",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Comment": "The token is already dead: the wrapper has moved on.",
          "Output": "{% $states.input %}",
          "Next": "Registered"
        }
      ]
    },
    "Registered": {
      "Type": "Succeed"
    }
  }
}
