# =============================================================================
# polyris .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Terraform
# -----------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# -----------------------------------------------------------------------------
# Node.js / React (ui/)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.cache/
.parcel-cache/
.next/
# Next.js static export output (`next build` with output:'export') — build
# artifact, regenerated by ui/deploy.sh; must never be committed.
out/
ui/out/
.nuxt/
.output/
.vercel/

# -----------------------------------------------------------------------------
# IDE / Editors
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/

# -----------------------------------------------------------------------------
# Build artifacts
# -----------------------------------------------------------------------------
*.zip
.build/

# SAM build cache — machine-specific absolute paths in build.toml (codeuri).
# Regenerated on every `sam build`; should never be committed.
.aws-sam/

# TypeScript incremental compilation cache — file hashes + timestamps from the
# local machine. Regenerated by tsc on every typecheck.
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Environment / Secrets
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json

# Deploy config carries inline secrets — only the sanitized .example is tracked.
sam/samconfig.toml


# Local working copies of examples with real account IDs — never publish
examples_temp/

# User pipeline definitions live outside the repo (were sample acme/shopmart;
# real account IDs must never be published). Users create their own pipelines/.
pipelines/
