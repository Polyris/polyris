# Polyris Console — local dev environment (copy to .env.local for `npm run dev`)
#
# The console is a static export (no Next.js server at runtime), so the browser
# calls the deployed API Gateway DIRECTLY — there is no server-side proxy.
#
# Point NEXT_PUBLIC_API_URL at the full API Gateway invoke URL, INCLUDING the
# stage AND the trailing /api. This is exactly what ui/deploy.sh writes into
# config.js on a real deploy (ConsoleApiUrl + "/api"), and the route paths in the
# code are appended without /api (e.g. base + "/pipelines").
#
#   Format: https://<id>.execute-api.<region>.amazonaws.com/<stage>/api
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev/api

# Auth. Leave false unless the API was deployed with AUTH_ENABLED=true.
# (CORS is wide open — Access-Control-Allow-Origin: * — so localhost works as-is.)
NEXT_PUBLIC_AUTH_ENABLED=false

# Cognito — only when NEXT_PUBLIC_AUTH_ENABLED=true. Amplify signs in with
# email/password directly, so there are NO OAuth callback URLs to register for
# localhost. These must match the pool/client the console-api Lambda validates.
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_COGNITO_REGION=us-east-1
